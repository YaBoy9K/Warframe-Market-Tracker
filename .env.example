# Discord webhook used by both trackers.
# Never commit your real webhook URL.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/REPLACE_ME/REPLACE_ME

# Warframe.Market tracker
WFM_PLATFORM=pc
WFM_CROSSPLAY=true
WFM_USER_AGENT=warframe-market-discord-tracker/1.0
MARKET_POLL_SECONDS=60
MARKET_REQUEST_DELAY_SECONDS=0.40
MARKET_STATE_RETENTION_SECONDS=259200

# Mission tracker
MISSION_POLL_SECONDS=60
